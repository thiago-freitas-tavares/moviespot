{
  "name": "moviespot",
  "private": true,
  "version": "1.0.0",
  "description": "Catálogo de filmes em React que consome a API pública do TMDB, com foco em usabilidade (heurísticas de Nielsen) e acessibilidade (WCAG 2.2).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,site -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "concurrently -n api,site -c cyan,magenta \"npm:server\" \"vite preview\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
