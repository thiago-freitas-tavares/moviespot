# Copie este arquivo para ".env" e preencha UMA das variáveis abaixo.
# Obtenha as credenciais em https://www.themoviedb.org/settings/api

# Opção recomendada: "Token de leitura da API" (API Read Access Token, começa com "eyJ...")
VITE_TMDB_TOKEN=

# Alternativa: "Chave da API" (API Key v3, 32 caracteres)
VITE_TMDB_API_KEY=
